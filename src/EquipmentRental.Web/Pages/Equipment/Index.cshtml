@page
@model EquipmentRental.Web.Pages.Equipment.IndexModel
@{
    ViewData["Title"] = "Equipment";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Equipment List</h2>
    <a asp-page="Create" class="btn btn-success">+ Add New Equipment</a>
</div>

<div class="mb-3">
    <a asp-page="Index" class="btn btn-outline-secondary btn-sm @(!Model.ShowAll ? "active" : "")">Available Only</a>
    <a asp-page="Index" asp-route-showAll="true" class="btn btn-outline-secondary btn-sm @(Model.ShowAll ? "active" : "")">Show All</a>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Name</th>
                <th>Category</th>
                <th>Daily Rate</th>
                <th>Condition</th>
                <th>Available</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var equipment in Model.EquipmentList)
            {
                <tr>
                    <td>@equipment.Name</td>
                    <td>@equipment.Category</td>
                    <td>@equipment.DailyRate.ToString("C")</td>
                    <td>@equipment.Condition</td>
                    <td>
                        @if (equipment.IsAvailable)
                        {
                            <span class="badge bg-success">Yes</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">No</span>
                        }
                    </td>
                    <td>
                        @if (!User.IsInRole("Admin"))
                        {
                            {
                            <a asp-page="Edit" asp-route-id="@equipment.EquipmentId" class="btn btn-sm btn-warning">Edit</a>
                        }
                        <form method="post" asp-page-handler="Delete" asp-route-id="@equipment.EquipmentId" style="display:inline">
                            <button type="submit" class="btn btn-sm btn-danger"
                                onclick="return confirm('Are you sure you want to delete this equipment?')">Delete</button>
                        </form>
                        }
                        else
                        {
                            <span class="text-muted">No actions available</span>}
                       
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>