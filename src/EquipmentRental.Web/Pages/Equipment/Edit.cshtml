@page "{id:int}"
@model EquipmentRental.Web.Pages.Equipment.EditModel
@{
    ViewData["Title"] = "Edit Equipment";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Edit Equipment</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="Equipment.EquipmentId" />

                    <div class="mb-3">
                        <label asp-for="Equipment.Name" class="form-label fw-semibold"></label>
                        <input asp-for="Equipment.Name" class="form-control" />
                        <span asp-validation-for="Equipment.Name" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Equipment.Category" class="form-label fw-semibold"></label>
                        <input asp-for="Equipment.Category" class="form-control" />
                        <span asp-validation-for="Equipment.Category" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Equipment.DailyRate" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="Equipment.DailyRate" class="form-control" type="number" step="0.01" />
                        </div>
                        <span asp-validation-for="Equipment.DailyRate" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Equipment.Condition" class="form-label fw-semibold"></label>
                        <select asp-for="Equipment.Condition"
                                asp-items="Html.GetEnumSelectList<EquipmentRental.Domain.entities.EquipmentCondition>()"
                                class="form-select"></select>
                    </div>

                    <div class="mb-3 form-check">
                        <input asp-for="Equipment.IsAvailable" class="form-check-input" type="checkbox" />
                        <label asp-for="Equipment.IsAvailable" class="form-check-label fw-semibold">Available</label>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">Save Changes</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}