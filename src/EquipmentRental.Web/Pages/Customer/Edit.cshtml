@page
@model EquipmentRental.Web.Pages.Customer.EditModel

@{
    Layout = "_Layout";
}

<!DOCTYPE html>

<html>
<head>
    <title>Edit Customer</title>
</head>
<body>
    <div>
        <h2>Edit Customer</h2>
        <a asp-page="Index" class="btn btn-primary">Back</a>

        <form method="post">
            <input type="hidden" asp-for="Customer.CustomerId" />
            <div>
                <label asp-for="Customer.FirstName"></label>
                <input asp-for="Customer.FirstName" />
                <span asp-validation-for="Customer.FirstName"></span>
            </div>
            <div>
                <label asp-for="Customer.LastName"></label>
                <input asp-for="Customer.LastName" />
                <span asp-validation-for="Customer.LastName"></span>
            </div>
            <div>
                <label asp-for="Customer.Email"></label>
                <input asp-for="Customer.Email" type="email" />
                <span asp-validation-for="Customer.Email"></span>
            </div>
            <div>
                <label asp-for="Customer.PhoneNumber"></label>
                <input asp-for="Customer.PhoneNumber" type="tel" />
                <span asp-validation-for="Customer.PhoneNumber"></span>
            </div>
            <button type="submit">Save</button>
        </form>
    </div>
</body>
</html>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}