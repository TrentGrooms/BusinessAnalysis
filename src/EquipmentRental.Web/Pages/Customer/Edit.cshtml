@page "{id:int}"
@model EquipmentRental.Web.Pages.Customer.EditModel
@{
    ViewData["Title"] = "Edit Customer";
    Layout = "_Layout";
}

<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0">Edit Customer</h4>
            </div>
            <div class="card-body">
                <form method="post">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                    <input type="hidden" asp-for="Customer.CustomerId" />

                    <div class="mb-3">
                        <label asp-for="Customer.FirstName" class="form-label fw-semibold"></label>
                        <input asp-for="Customer.FirstName" class="form-control" />
                        <span asp-validation-for="Customer.FirstName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Customer.LastName" class="form-label fw-semibold"></label>
                        <input asp-for="Customer.LastName" class="form-control" />
                        <span asp-validation-for="Customer.LastName" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Customer.Email" class="form-label fw-semibold"></label>
                        <input asp-for="Customer.Email" class="form-control" type="email" />
                        <span asp-validation-for="Customer.Email" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Customer.PhoneNumber" class="form-label fw-semibold"></label>
                        <input asp-for="Customer.PhoneNumber" class="form-control" type="tel" />
                        <span asp-validation-for="Customer.PhoneNumber" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning">Save Changes</button>
                        <a asp-page="Index" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}