@page
@model EquipmentRental.Web.Pages.Rental.IndexModel
@{
    ViewData["Title"] = "Rentals";
    Layout = "_Layout";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2>Rental List</h2>
    <a asp-page="Create" class="btn btn-success">+ Create Rental</a>
</div>

<div class="mb-3">
    <a asp-page="Index" asp-route-filter="all" class="btn btn-outline-secondary btn-sm @(Model.Filter == "all" ? "active" : "")">All</a>
    <a asp-page="Index" asp-route-filter="active" class="btn btn-outline-secondary btn-sm @(Model.Filter == "active" ? "active" : "")">Active</a>
    <a asp-page="Index" asp-route-filter="late" class="btn btn-outline-secondary btn-sm @(Model.Filter == "late" ? "active" : "")">Late</a>
    <a asp-page="Index" asp-route-filter="closed" class="btn btn-outline-secondary btn-sm @(Model.Filter == "closed" ? "active" : "")">Closed</a>
</div>

@if (!string.IsNullOrEmpty(Model.SuccessMessage))
{
    <div class="alert alert-success">@Model.SuccessMessage</div>
}
@if (!string.IsNullOrEmpty(Model.ErrorMessage))
{
    <div class="alert alert-danger">@Model.ErrorMessage</div>
}

<div class="table-responsive">
    <table class="table table-striped table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th>Rental #</th>
                <th>Equipment</th>
                <th>Customer</th>
                <th>Rental Date</th>
                <th>Due Date</th>
                <th>Return Date</th>
                <th>Total Cost</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var rental in Model.Rentals)
            {
                var isLate = !rental.IsClosed && rental.DueDate < DateTime.Today;
                <tr class="@(isLate ? "table-warning" : "")">
                    <td>@rental.RentalId</td>
                    <td>@rental.Equipment.Name</td>
                    <td>@rental.Customer.FirstName @rental.Customer.LastName</td>
                    <td>@rental.RentalDate.ToString("MMM dd, yyyy")</td>
                    <td>@rental.DueDate.ToString("MMM dd, yyyy")</td>
                    <td>
                        @if (rental.ReturnDate.HasValue)
                        {
                            @rental.ReturnDate.Value.ToString("MMM dd, yyyy")
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        @if (rental.TotalCost > 0)
                        {
                            @rental.TotalCost.ToString("C")
                        }
                        else
                        {
                            <span class="text-muted">-</span>
                        }
                    </td>
                    <td>
                        @if (rental.IsClosed)
                        {
                            <span class="badge bg-secondary">Closed</span>
                        }
                        else if (isLate)
                        {
                            <span class="badge bg-danger">Late</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Active</span>
                        }
                    </td>
                    <td>
                        @if (!rental.IsClosed)
                        {
                            <form method="post" asp-page-handler="Close" asp-route-id="@rental.RentalId" style="display:inline">
                                <button type="submit" class="btn btn-sm btn-primary"
                                    onclick="return confirm('Close this rental and return the equipment?')">Close Rental</button>
                            </form>
                        }
                        else
                        {
                            <span class="text-muted">Completed</span>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
